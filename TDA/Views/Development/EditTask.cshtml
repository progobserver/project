@model TDA.Models.ActualTask
@{
    ViewData["Title"] = "EditTask";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<html>
<head>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <form asp-action="EditTask" asp-controller="Development" asp-route-id="@Model.TaskId" method="post">
        <h2>Редактировать задачу</h2>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label asp-for="Title">Название</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Description" class="control-label">Задача</label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Project.ProjectName" class="control-label">Проект</label>
            <input asp-for="Project.ProjectName" class="form-control" />
            <span asp-validation-for="Project.ProjectName" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Priority.PriorityMessage" class="control-label">Приоритет</label>
            <input asp-for="Priority.PriorityMessage" class="form-control" />
            <span asp-validation-for="Priority.PriorityMessage" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Deadline">Введите дедлайн</label>
            <input asp-for="Deadline" type="date" min="@DateTime.Now.ToString("dd.MM.yyyy")" class="form-control" />
            <span asp-validation-for="Deadline" class="field-validation-error"></span>
        </div>
        <div style="margin-top:10px;">
            <input type="submit" value="Сохранить" class="button" />
        </div>
    </form>
</body>
</html>

@model TDA.Models.ActualTask
@{
    ViewData["Title"] = "DeleteTask";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<html>
<head>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

</head>
<body>
    <h2>Подтвердите удаление</h2>
    <div class="form-group">
        <dl class="dl-horizontal">
            <dt>Название</dt>
            <dd>@Html.DisplayFor(model => model.Title)</dd>
            <dt>Задача</dt>
            <dd>@Html.DisplayFor(model => model.Description)</dd>
        </dl>
        <form asp-controller="Development" asp-action="DeleteTask" method="post">
            @Html.AntiForgeryToken()
            <input type="submit" class="delete-button" value="Удалить" />
        </form>
    </div>
</body>
</html>

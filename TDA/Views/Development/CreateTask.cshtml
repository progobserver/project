@model TDA.Models.ActualTaskModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<html>
<head>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <form asp-action="CreateTask" asp-controller="Development" asp-anti-forgery="true" method="post">
        <h2>Создание задчи</h2>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label asp-for="Title">Введите название задачи</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Description">Введите описание задачи</label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Project">Введите проект</label>
            <input asp-for="Project" class="form-control" value="@Model.Project" />
            <span asp-validation-for="Project" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Priority">Введите приоритетность</label>
            <input asp-for="Priority" class="form-control" />
            <span asp-validation-for="Priority" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Deadline">Введите дедлайн</label>
            <input asp-for="Deadline" type="date" min="@DateTime.Now.ToString("dd.MM.yyyy")" />
            <span asp-validation-for="Deadline" class="field-validation-error"></span>
        </div>
        <div style="margin-top:10px;">
            <input type="submit" value="Создать" class="button" />
        </div>
    </form>
</body>
</html>

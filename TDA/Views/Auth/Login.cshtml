@model TDA.Models.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<html>
<head>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <h2>Вход на сайт</h2>
    <form asp-action="Login" asp-controller="Auth" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <div class="form-group">
            <label asp-for="Login">Введите логин</label>
            <input asp-for="Login" class="form-control" />
            <span asp-validation-for="Login" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password">Введите пароль</label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>
        <div style="margin-top:10px; text-align:center;">
            <input type="submit" value="Войти" class="button" />
        </div>
        <div style="margin-top:10px; text-align:center;">
            <a asp-action="Register" asp-controller="Register">Регистрация</a>
        </div>
    </form>
</body>
</html>

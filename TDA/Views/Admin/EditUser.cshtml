@model TDA.Models.User
@{
    ViewData["Title"] = "EditUser";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<html>
<head>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <form asp-action="EditUser" asp-controller="Admin" asp-route-id="@Model.UserId" method="post">
        <h2>Изменение данных пользователя</h2>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label asp-for="Username">Имя</label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Role.RoleName" class="control-label">Роль</label>
            <input asp-for="Role.RoleName" class="form-control" />
            <span asp-validation-for="Role.RoleName" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Email" class="control-label">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
        <div style="margin-top:10px;">
            <input type="submit" value="Сохранить" class="button" />
        </div>
    </form>
</body>
</html>

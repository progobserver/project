@model TDA.Models.User
@{
    ViewData["Title"] = "DeleteUser";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<html>
<head>   
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <h2>Подтвердите удаление пользователя</h2>
    <h3>Это действие нельзя отменить!</h3>
    <form asp-controller="Admin" asp-action="DeleteUser" method="post">
    <div class="form-group">
        <dl class="dl-horizontal">
            <dt>Пользователь</dt>
            <dd>@Html.DisplayFor(model => model.Username)</dd>
        </dl>
        
            @Html.AntiForgeryToken()
            <input type="submit" class="delete-button" value="Удалить" />
       
    </div>
    </form>
</body>
</html>

@model TDA.Models.User
@{
    ViewData["Title"] = "BlockUser";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<html>
<head>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <h2>Подтвердите блокировку пользователя</h2>
    <form asp-controller="Admin" asp-action="BlockUser" method="post">
        <div class="form-group">
            <dl class="dl-horizontal">
                <dt>Пользователь</dt>
                <dd>@Html.DisplayFor(model => model.Username)</dd>
            </dl>

            @Html.AntiForgeryToken()
            <input type="submit" class="delete-button" value="Заблокировать" />

        </div>
    </form>
</body>
</html>

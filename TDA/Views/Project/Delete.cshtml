@model TDA.Models.Project
@{
    ViewData["Title"] = "Delete";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<html>
<head>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <h2>Подтвердите удаление</h2>
    <div class="form-group">
        <dl class="dl-horizontal">
            <dt>Проект</dt>
            <dd>@Html.DisplayFor(model => model.ProjectName)</dd>
            <dt>Руководитель</dt>
            <dd>@Html.DisplayFor(model => model.LeadId)</dd>
        </dl>
        <form asp-controller="Project" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="submit" class="delete-button" value="Удалить" />
        </form>
    </div>
</body>
</html>

@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "ViewProject";
}
@model IEnumerable<TDA.Models.Project>
<html>
    <head>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    </head>
<body>

    <h2>Список проектов</h2>
    @if (User.IsInRole("admin") || User.IsInRole("manager"))
    {
        <p><a href="/Project/CreateProject">Добавить проект</a></p>
    }
    <table class="table">
        <thead>
            <tr><th>Проект</th><th>Руководитель</th><th>
        </thead>
        <tbody>
            @foreach (var project in Model)
            {
                <tr>
                    <td>
                        <a asp-action="TasksByProject" asp-controller="Development" asp-route-projectId="@project.ProjectId">
                            @project.ProjectName
                        </a>
                    </td>
                    <td>@project.Lead.Username</td>
                    <td>
                        @if (User.IsInRole("admin") || User.IsInRole("manager"))
                        {
                            <a asp-action="Edit" asp-controller="Project" asp-route-id="@project.ProjectId">Изменить</a>
                            <a asp-action = "Delete" asp-controller = "Project" asp-route-id = "@project.ProjectId" > Удалить </a>
                            }
                        else
                        {
                            <span>Нажмите на название проекта для подробностей </span>
                        }
                    </td>
                </tr>
            }
            
            </tbody>
    </table>


</body>
</html>
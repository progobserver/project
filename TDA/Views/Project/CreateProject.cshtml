@model TDA.Models.ProjectModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<html>
<head>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <form asp-action="CreateProject" asp-controller="Project" asp-anti-forgery="true" method="post">
        <h2>Создание проекта</h2>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label asp-for="Name">Введите название проекта</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="LeadId">Выберите руководителя</label>
            <select asp-for="LeadId" class="form-control" asp-items="@(new SelectList(ViewBag.UsersList, "UserId", "Username"))">
                <option value="">-- Выберите руководителя --</option>
            </select>
            <span asp-validation-for="LeadId" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Description">Введите описание проекта</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="field-validation-error"></span>
        </div>
        <div style="margin-top:10px;">
            <input type="submit" value="Создать" class="button" />
        </div>
    </form>
</body>
</html>

@model TDA.Models.Project
@{
    ViewData["Title"] = "Edit";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<html>
<head>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <form asp-action="Edit" asp-controller="Project" asp-route-id="@Model.ProjectId" method="post">
        <h2>Изменение данных проекта</h2>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label asp-for="ProjectName">Имя</label>
            <input asp-for="ProjectName" class="form-control" />
            <span asp-validation-for="ProjectName" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="LeadId">Выберите руководителя</label>
            <select asp-for="LeadId" class="form-control" asp-items="@(new SelectList(ViewBag.UsersList, "UserId", "Username"))">
                <option value="">-- Выберите руководителя --</option>
            </select>
            <span asp-validation-for="LeadId" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Description" class="control-label">Введите описание проекта</label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="field-validation-error"></span>
        </div>
        <div style="margin-top:10px;">
            <input type="submit" value="Сохранить" class="button" />
        </div>
    </form>
</body>
</html>
